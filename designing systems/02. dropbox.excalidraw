    {
      "id": "nDNu4wfqwzG-RocOJqpqU",
      "type": "text",
      "x": -588.3863306679009,
      "y": 428.1216009971514,
      "width": 680.911761776022,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 1336035,
      "version": 183,
      "versionNonce": 1342246243,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780649203124,
      "link": null,
      "locked": false,
      "text": "// Upload a file\nPOST /files -> id + 200\n{\n    file,\n    file_metadata,\n    owner_id,\n}\n\n// Download a file\nGET files/{id} -> file\n\n// Share a file\nPATCH files/{id} -> id\n{\n    shared_with: user[]\n}\n\nGET files/{id} -> file\n\n// Automatically sync files across devices (call out the upload/download endpoints)\n// - we need to know what's changed\n// - the changes that happened within that workspace\n// - everytime we do a change to some file, we need to write a \"log\" here\nGET /changes?since={timeStamp} -> File['id'][]",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Upload a file\nPOST /files -> id + 200\n{\n    file,\n    file_metadata,\n    owner_id,\n}\n\n// Download a file\nGET files/{id} -> file\n\n// Share a file\nPATCH files/{id} -> id\n{\n    shared_with: user[]\n}\n\nGET files/{id} -> file\n\n// Automatically sync files across devices (call out the upload/download endpoints)\n// - we need to know what's changed\n// - the changes that happened within that workspace\n// - everytime we do a change to some file, we need to write a \"log\" here\nGET /changes?since={timeStamp} -> File['id'][]",
      "autoResize": false,
      "lineHeight": 1.25
    },
