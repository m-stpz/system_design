      "type": "text",
      "x": 14779.535761963498,
      "y": 3223.3352100000006,
      "width": 345.13568115234375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
