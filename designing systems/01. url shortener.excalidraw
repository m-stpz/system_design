      "isDeleted": false,
      "boundElements": [],
      "updated": 1783099767406,
      "link": null,
      "locked": false,
      "text": "algo to ensure non-duplicate entries\ncreateUrl \n    - pseudocode\n       \n    match = true \n\n    while (match){\n         shortGeneratedVersion = generateBase62()\n        dbResult = db.get(shortGeneratedVersion)\n\n        if (shortGeneratedVersion === dbResult){\n            match = true \n        } else {\n            match = false\n            db.post(shortGeneratedVersion)\n        }\n     }\n\n         \n    \n  \n            \n ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "algo to ensure non-duplicate entries\ncreateUrl \n    - pseudocode\n       \n    match = true \n\n    while (match){\n         shortGeneratedVersion = generateBase62()\n        dbResult = db.get(shortGeneratedVersion)\n\n        if (shortGeneratedVersion === dbResult){\n            match = true \n        } else {\n            match = false\n            db.post(shortGeneratedVersion)\n        }\n     }\n\n         \n    \n  \n            \n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
