      "index": "bShS",
      "roundness": null,
      "seed": 341767665,
      "version": 134,
      "versionNonce": 1653209702,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783099039121,
      "link": null,
      "locked": false,
      "text": "100k DAU\n- how many will be generating urls?\n\n100k / 100 -> 1k urls being created per day ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "100k DAU\n- how many will be generating urls?\n\n100k / 100 -> 1k urls being created per day ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EXwa45-u0fU9ZSZO2voE4",
      "type": "text",
      "x": 14779.535761817575,
      "y": 3339.5928670000003,
      "width": 436.99749755859375,
      "height": 215.8302849999991,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bShSV",
      "roundness": null,
      "seed": 758309809,
      "version": 814,
      "versionNonce": 1593165562,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783099039121,
      "link": null,
      "locked": false,
      "text": "100M \n - how many characters should our url have?\n - how many urls would a user created in his/her lifetime?\n    - max. 100\n\n100M * 100 = 10 billion combinations\n\nhow long should our url be?\n    - base62 [A-Z/a-z/0-9]\n\n62 ^ x ? = 6/7 characters",
      "fontSize": 15.696747999999936,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "100M \n - how many characters should our url have?\n - how many urls would a user created in his/her lifetime?\n    - max. 100\n\n100M * 100 = 10 billion combinations\n\nhow long should our url be?\n    - base62 [A-Z/a-z/0-9]\n\n62 ^ x ? = 6/7 characters",
      "autoResize": true,
      "lineHeight": 1.25
    },
